{
    "name": "saizulamin/portfolio",
    "description": "Saizul Amin portfolio: lightweight custom PHP MVC framework",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Controllers\\Fixtures\\": "tests/Fixtures/",
            "App\\": "app/",
            "Tests\\": "tests/"
        },
        "files": [
            "app/Helpers/functions.php",
            "app/Helpers/sanitize.php"
        ]
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}

# ── Application ──────────────────────────────────────────────
APP_NAME="Saizul Amin Portfolio"
APP_ENV=production
APP_URL=https://saizulamin.com
APP_KEY=generate_with_bin2hex_random_bytes_32
APP_DEBUG=false

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=saizul_portfolio
DB_USERNAME=saizul_user
DB_PASSWORD=your_secure_password

# ── Mail (optional) ─────────────────────────────────────────
MAIL_HOST=mail.saizulamin.com
MAIL_PORT=587
MAIL_USERNAME=hello@saizulamin.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM_ADDRESS=hello@saizulamin.com
MAIL_FROM_NAME="Saizul Amin"
# Inbox that receives contact-form messages (defaults to ADMIN_EMAIL)
MAIL_TO=hello@saizulamin.com

# ── Admin ────────────────────────────────────────────────────
ADMIN_NAME=Saizul Amin
ADMIN_EMAIL=saizulamin@gmail.com

# ── Proxy ────────────────────────────────────────────────────
# Leave empty unless the site sits behind a proxy you control.
# Behind Cloudflare set it to HTTP_CF_CONNECTING_IP so the contact-form
# rate limit sees real visitor IPs instead of the proxy's.
TRUSTED_PROXY_HEADER=
